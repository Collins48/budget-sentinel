# Copy this file to .env (same folder as docker-compose.yml) and fill in real
# values. .env is read automatically by `docker compose` and is NOT committed
# to git — never put real secrets in docker-compose.yml itself.

# --- Real email delivery (Gmail SMTP, free) ---
# 1. Turn on 2-Step Verification on the Gmail account: myaccount.google.com/security
# 2. Create an App Password: myaccount.google.com/apppasswords (choose "Mail" / "Other")
# 3. Paste the 16-character app password below (NOT your normal Gmail password)
SMTP_RELAY=smtp.gmail.com
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=your16charapppassword

# --- AI audit report generation (optional) ---
# Without this, audit reports use a deterministic fallback template instead of Claude.
ANTHROPIC_API_KEY=
